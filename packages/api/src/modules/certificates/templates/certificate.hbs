<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page { size: A4 landscape; margin: 0; }
    * { box-sizing: border-box; }
    body { margin: 0; padding: 0; font-family: 'Times New Roman', Times, serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .certificate {
      width: 297mm;
      height: 210mm;
      page-break-after: always;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .certificate:last-child {
      page-break-after: auto;
    }

    .bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }

    .content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 42mm 28mm 20mm;
    }

    .text {
      font-size: 18pt;
      line-height: 1.7;
      max-width: 210mm;
      color: #1a1a2e;
      margin-bottom: 18mm;
    }

    .signatures {
      display: flex;
      justify-content: center;
      gap: 20mm;
      width: 100%;
    }

    .signature {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 70mm;
    }

    .signature-img-wrap {
      height: 20mm;
      width: 70mm;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      margin-bottom: 0;
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    .signature-img-wrap img {
      width: 70mm;
      height: 20mm;
      object-fit: contain;
      object-position: center bottom;
      display: block;
    }

    .signature-line {
      width: 70mm;
      border-top: 1.5px solid #1a1a2e;
      position: relative;
      z-index: 1;
    }

    .signature-name {
      font-size: 11pt;
      font-weight: bold;
      padding-top: 2mm;
      width: 70mm;
      text-align: center;
      color: #1a1a2e;
    }

    .signature-role {
      font-size: 9pt;
      color: #444;
      text-align: center;
    }

    .verification {
      position: absolute;
      bottom: 6mm;
      right: 8mm;
      font-size: 7pt;
      color: #666;
      text-align: right;
      line-height: 1.4;
      z-index: 2;
    }
  </style>
</head>
<body>
  {{#each participants}}
    <div class="certificate">
      <img class="bg" src="{{../backgroundUrl}}" />
      <div class="content">
        <div class="text"><span>{{{this.processedText}}}</span></div>

        <div class="signatures">
          {{#each ../signatures}}
            <div class="signature">
              <div class="signature-img-wrap">
                <img src="{{this.imageUrl}}" />
              </div>
              <div class="signature-line"></div>
              <div class="signature-name">{{this.personName}}</div>
              <div class="signature-role">{{this.personRole}}</div>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="verification">
        Código: {{../verificationCode}}-{{this.id}}<br>
        Gerado em: {{../generatedAt}}
      </div>
    </div>
  {{/each}}
</body>
</html>

{{> header}}
  <h1>{{event.name}}</h1>
  <p class="event-meta">{{event.eventDate}} &bull; {{event.location}} &bull; {{event.organizer}}</p>
  <h2>Classificação Final — Top {{topN}}</h2>

  {{#each categories}}
    <h3>{{this.categoryName}}</h3>
    <table>
      <thead><tr><th class="position">Pos.</th><th>Participante</th><th class="score">Nota</th></tr></thead>
      <tbody>
        {{#each this.entries}}
        <tr>
          <td class="position">{{this.position}}º</td>
          <td>{{this.participantName}}</td>
          <td class="score">{{this.finalScore}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  {{/each}}
{{> footer}}

# ──────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente da API — copie este arquivo para .env e preencha os valores
# Em produção (Railway), configure estas variáveis diretamente no painel do Railway.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Banco de dados — fornecido automaticamente pelo serviço PostgreSQL do Railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — URL(s) do frontend, separadas por vírgula se houver mais de uma
# Exemplo produção: https://meu-sistema-web.up.railway.app
CORS_ORIGIN=http://localhost:3001

# JWT — gere os secrets com: node scripts/gen-secrets.js
JWT_ACCESS_SECRET=ALTERE_PARA_UM_SECRET_ALEATORIO_DE_PELO_MENOS_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ALTERE_PARA_UM_SECRET_DIFERENTE_DO_ACCESS_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Segurança — aumente para 12 em produção para maior resistência a ataques de força bruta
BCRYPT_ROUNDS=12

# Rate limiting — login: máx. 5 tentativas a cada 60s
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5

# Armazenamento de arquivos
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
PARTICIPANT_PHOTO_MAX_BYTES=2097152
PARTICIPANT_PHOTO_ALLOWED_MIMES=image/jpeg,image/png

# Redis — fornecido automaticamente pelo serviço Redis do Railway
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do frontend — copie para .env.local (desenvolvimento)
# Em produção (Railway), configure diretamente no painel do Railway.
# ──────────────────────────────────────────────────────────────────────────────

# URL pública da API com o prefixo /api
# Desenvolvimento: http://localhost:3000/api
# Produção: https://sistema-julgamento-api.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# URL base da API (sem /api) — usada para WebSocket
# Desenvolvimento: http://localhost:3000
# Produção: https://sistema-julgamento-api.up.railway.app
NEXT_PUBLIC_WS_URL=http://localhost:3000
